{
    "info": {
      "name": "Dokkan Alliance Supabase API Tests",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "userToken",
        "value": ""
      },
      {
        "key": "userId",
        "value": ""
      },
      {
        "key": "adminToken",
        "value": ""
      },
      {
        "key": "teamId",
        "value": ""
      },
      {
        "key": "charId",
        "value": ""
      }
    ],
    "item": [
      {
        "name": "Setup: log in as test user",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Not an admin', () => pm.expect(json.user.app_metadata.role).to.not.eql('admin'));",
                "pm.collectionVariables.set('userToken', json.access_token);",
                "pm.collectionVariables.set('userId', json.user.id);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
          "body": {
            "mode": "raw",
            "raw": "{\"email\": \"{{userEmail}}\", \"password\": \"{{userPassword}}\"}"
          }
        }
      },
      {
        "name": "Setup: log in as admin",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Is an admin', () => pm.expect(json.user.app_metadata.role).to.eql('admin'));",
                "pm.collectionVariables.set('adminToken', json.access_token);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
          "body": {
            "mode": "raw",
            "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{adminPassword}}\"}"
          }
        }
      },
      {
        "name": "APIT-9 Save team to account",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const team = pm.response.json()[0];",
                "pm.test('Team saved with its name', () => pm.expect(team.name).to.eql('APIT Team'));",
                "pm.collectionVariables.set('teamId', team.id);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            },
            {
              "key": "Prefer",
              "value": "return=representation"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/teams",
          "body": {
            "mode": "raw",
            "raw": "{\"user_id\": \"{{userId}}\", \"name\": \"APIT Team\"}"
          }
        }
      },
      {
        "name": "UT-4 (DB) 7th slot is rejected",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Slot 6 (7th member) is rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 409]));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/team_members",
          "body": {
            "mode": "raw",
            "raw": "{\"team_id\": \"{{teamId}}\", \"slot\": 6, \"card_id\": 1}"
          }
        }
      },
      {
        "name": "APIT-11 Edit team (set a slot)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const member = pm.response.json()[0];",
                "pm.test('Slot 0 holds card 1', () => {",
                "  pm.expect(member.slot).to.eql(0);",
                "  pm.expect(member.card_id).to.eql(1);",
                "});"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            },
            {
              "key": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/team_members?on_conflict=team_id,slot",
          "body": {
            "mode": "raw",
            "raw": "{\"team_id\": \"{{teamId}}\", \"slot\": 0, \"card_id\": 1}"
          }
        }
      },
      {
        "name": "APIT-10 Retrieve saved teams",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const teams = pm.response.json();",
                "const mine = teams.find(t => t.id === pm.collectionVariables.get('teamId'));",
                "pm.test('Saved team is returned', () => pm.expect(mine).to.not.eql(undefined));",
                "pm.test('Edit from APIT-11 is saved', () => pm.expect(mine.team_members[0].card_id).to.eql(1));"
              ]
            }
          }
        ],
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/teams?select=id,name,team_members(slot,card_id)&order=created_at"
        }
      },
      {
        "name": "SET-4 (API) Non-admin cannot add a character",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Blocked by RLS (403)', () => pm.response.to.have.status(403));",
                "pm.test('Policy violation code', () => pm.expect(pm.response.json().code).to.eql('42501'));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"APIT Test Character\",\n  \"title\": \"APIT Title\",\n  \"class\": \"super\",\n  \"type\": \"agl\",\n  \"leader_skill\": \"Test leader skill\",\n  \"hp_55\": 1000,\n  \"atk_55\": 1000,\n  \"def_55\": 1000,\n  \"hp_rainbow\": 2000,\n  \"atk_rainbow\": 2000,\n  \"def_rainbow\": 2000,\n  \"supers\": [\n    {\n      \"style\": \"Normal\",\n      \"kiNeeded\": 12,\n      \"name\": \"Test Super\",\n      \"description\": \"Test description\"\n    }\n  ],\n  \"passive_name\": null,\n  \"passive_description\": null\n}"
          }
        }
      },
      {
        "name": "APIT-12 Admin adds character",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const created = pm.response.json()[0];",
                "pm.test('Character saved', () => pm.expect(created.name).to.eql('APIT Test Character'));",
                "pm.test('Gets an admin id (1000000000+)', () => pm.expect(created.id).to.be.at.least(1000000000));",
                "pm.collectionVariables.set('charId', created.id);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{adminToken}}"
            },
            {
              "key": "Prefer",
              "value": "return=representation"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"APIT Test Character\",\n  \"title\": \"APIT Title\",\n  \"class\": \"super\",\n  \"type\": \"agl\",\n  \"leader_skill\": \"Test leader skill\",\n  \"hp_55\": 1000,\n  \"atk_55\": 1000,\n  \"def_55\": 1000,\n  \"hp_rainbow\": 2000,\n  \"atk_rainbow\": 2000,\n  \"def_rainbow\": 2000,\n  \"supers\": [\n    {\n      \"style\": \"Normal\",\n      \"kiNeeded\": 12,\n      \"name\": \"Test Super\",\n      \"description\": \"Test description\"\n    }\n  ],\n  \"passive_name\": null,\n  \"passive_description\": null\n}"
          }
        }
      },
      {
        "name": "APIT-13 Missing stats field is rejected",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                "pm.test('Not-null violation on a stat', () => pm.expect(pm.response.json().code).to.eql('23502'));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{adminToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"name\": \"APIT Test Character\",\n  \"title\": \"APIT Title\",\n  \"class\": \"super\",\n  \"type\": \"agl\",\n  \"leader_skill\": \"Test leader skill\",\n  \"atk_55\": 1000,\n  \"def_55\": 1000,\n  \"hp_rainbow\": 2000,\n  \"atk_rainbow\": 2000,\n  \"def_rainbow\": 2000,\n  \"supers\": [\n    {\n      \"style\": \"Normal\",\n      \"kiNeeded\": 12,\n      \"name\": \"Test Super\",\n      \"description\": \"Test description\"\n    }\n  ],\n  \"passive_name\": null,\n  \"passive_description\": null\n}"
          }
        }
      },
      {
        "name": "APIT-14 Admin edits character info",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                "const edited = pm.response.json()[0];",
                "pm.test('Title updated', () => pm.expect(edited.title).to.eql('APIT Edited Title'));",
                "pm.test('Same row was updated, not duplicated', () => pm.expect(edited.id).to.eql(pm.collectionVariables.get('charId')));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{adminToken}}"
            },
            {
              "key": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters?on_conflict=id",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"id\": {{charId}},\n  \"name\": \"APIT Test Character\",\n  \"title\": \"APIT Edited Title\",\n  \"class\": \"super\",\n  \"type\": \"agl\",\n  \"leader_skill\": \"Test leader skill\",\n  \"hp_55\": 1000,\n  \"atk_55\": 1000,\n  \"def_55\": 1000,\n  \"hp_rainbow\": 2000,\n  \"atk_rainbow\": 2000,\n  \"def_rainbow\": 2000,\n  \"supers\": [\n    {\n      \"style\": \"Normal\",\n      \"kiNeeded\": 12,\n      \"name\": \"Test Super\",\n      \"description\": \"Test description\"\n    }\n  ],\n  \"passive_name\": null,\n  \"passive_description\": null\n}"
          }
        }
      },
      {
        "name": "APIT-15 Update stats after game patch",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const updated = pm.response.json()[0];",
                "pm.test('Stats updated', () => {",
                "  pm.expect(updated.hp_55).to.eql(1500);",
                "  pm.expect(updated.atk_rainbow).to.eql(2500);",
                "});"
              ]
            }
          }
        ],
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{adminToken}}"
            },
            {
              "key": "Prefer",
              "value": "return=representation"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters?id=eq.{{charId}}",
          "body": {
            "mode": "raw",
            "raw": "{\"hp_55\": 1500, \"atk_rainbow\": 2500}"
          }
        }
      },
      {
        "name": "Cleanup: delete test character",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Deleted (204)', () => pm.response.to.have.status(204));"
              ]
            }
          }
        ],
        "request": {
          "method": "DELETE",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{adminToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/characters?id=eq.{{charId}}"
        }
      },
      {
        "name": "Cleanup: delete test team",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Deleted (204)', () => pm.response.to.have.status(204));"
              ]
            }
          }
        ],
        "request": {
          "method": "DELETE",
          "header": [
            {
              "key": "apikey",
              "value": "{{supabaseKey}}"
            },
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Authorization",
              "value": "Bearer {{userToken}}"
            }
          ],
          "url": "{{supabaseUrl}}/rest/v1/teams?id=eq.{{teamId}}"
        }
      }
    ]
  }